{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    ".read": false,
    ".write": false,
    "prints": {
      ".read": "auth != null",
      "$day": {
        ".write": "auth != null"
      }
    },
    "productSelections": {
      ".read": "auth != null",
      "$flow": {
        "$group": {
          "$letter": {
            ".write": "auth != null"
          }
        }
      }
    },
    "labelSequences": {
      ".read": "auth != null",
      "$day": {
        "$sequence": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
        }
      }
    }
  }
}
